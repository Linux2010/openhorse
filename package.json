    "@babel/core": "^7.29.7",
    "@babel/node": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/figlet": "^1.5.8",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.15",
    "@types/uuid": "^9.0.0",
    "esbuild-runner": "^2.2.2",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
